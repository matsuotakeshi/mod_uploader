# Altered mod_uploader 3.2.0: Enterprise Linux configuration sample.
# NOT automatically enabled. Review before adding an Include to httpd.conf.
# Module is loaded by conf.modules.d/20-uploader.conf (RPM).
# Include this file INSIDE the dedicated HTTPS VirtualHost; configure TLS there.

<Location />
    SetHandler uploader
    Require local
    LimitRequestBody 11534336
    UploaderBaseUrl "https://up.ysni.org/"
    UploaderDataDirectory "/var/lib/mod_uploader/data"
    UploaderFileDirectory "/var/lib/mod_uploader/file"
    UploaderThumbDirectory "/var/lib/mod_uploader/thumb"
    UploaderTempDirectory "/var/lib/mod_uploader/temp"
    # mod_uploader size limits are KiB (LimitRequestBody above is bytes).
    UploaderTotalFileSizeLimit 1048576
    UploaderTotalFileNumberLimit 1000
    UploaderFileSizeLimit 10240
    UploaderPerPageItemNumber 30
    UploaderIndexViewTemplate "/usr/share/mod_uploader/tmpl/index.htm"
    UploaderInfoViewTemplate "/usr/share/mod_uploader/tmpl/info.htm"
    UploaderProgressViewTemplate "/usr/share/mod_uploader/tmpl/progress.htm"
    UploaderDownloadViewTemplate "/usr/share/mod_uploader/tmpl/download.htm"
    UploaderThumbnailViewTemplate "/usr/share/mod_uploader/tmpl/thumbnail.htm"
    UploaderAdminViewTemplate "/usr/share/mod_uploader/tmpl/admin.htm"
    UploaderErrorViewTemplate "/usr/share/mod_uploader/tmpl/error.htm"
</Location>
# Administration is disabled until explicitly configured with Apache authentication.
# See SECURITY-MIGRATION-ja.md for AuthType Basic + Require valid-user over HTTPS.
<Location /admin>
    Require all denied
</Location>
<Location /mail>
    Require all denied
</Location>
# Root mounts also need an explicit static handler; Alias alone does not reset SetHandler.
<LocationMatch "^/up_(img|css|js|swf)(/|$)">
    SetHandler default-handler
    Require all granted
</LocationMatch>
Alias /up_css "/usr/share/mod_uploader/css"
Alias /up_js "/usr/share/mod_uploader/js"
Alias /up_img "/usr/share/mod_uploader/img"
<Directory "/usr/share/mod_uploader">
    AllowOverride None
    Options -Indexes -ExecCGI -Includes
    Require all granted
</Directory>
<Directory "/var/lib/mod_uploader">
    AllowOverride None
    Require all denied
</Directory>

# If serving legacy SWF files, configure an Alias /up_swf to a separate read-only directory.
# Flash execution is unsupported; the static-handler exception does not enable Flash.
