# Unix build scripts must remain executable after a Windows checkout or archive.
configure text eol=lf
configure.ac text eol=lf
*.m4 text eol=lf
build/** text eol=lf
GNUmakefile* text eol=lf
*.sh text eol=lf
*.pl text eol=lf
*.py text eol=lf

ports/** text eol=lf
ports/**/files/patch-* -text -whitespace
tests/** text eol=lf
docs/validation/*.log -whitespace

util/*.py text eol=lf
docs/validation/security-format4/*.log -whitespace
docs/validation/security-hardening/*.log -whitespace
docs/validation/security-audit/**/*.log -whitespace
docs/validation/security-audit/*.log -whitespace
docs/validation/root-deployment/**/*.log -whitespace
docs/validation/root-deployment/*.log -whitespace
docs/validation/archive-lf/*.log -whitespace

packaging/** text eol=lf
docs/validation/linux/**/*.log -whitespace
