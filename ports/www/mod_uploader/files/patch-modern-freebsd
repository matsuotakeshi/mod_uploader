+static const char *csrf_token(typename Response::Handle *r) {
+#if defined(UPLOADER_TYPE_APACHE) && AP_SERVER_MAJORVERSION_NUMBER >= 2
+    const char *token=apr_table_get(r->notes,"uploader-csrf-token");return token?token:"";
